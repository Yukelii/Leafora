# --- model location ---------------------------------------------------------
# Exported Keras model produced by `python -m training.train`.
# Relative paths are resolved from the backend/ folder.
# Stage-2 (field fine-tuned) export is preferred by default; set this to
# models/exported/leafora_densenet121.keras to serve the lab-only stage-1 model.
MODEL_PATH=models/exported/leafora_densenet121_field.keras
# JSON list holding the exact class order used during training.
CLASS_NAMES_PATH=app/ml/class_names.json
# Shown by /api/health and in every prediction response.
MODEL_VERSION=leafora-densenet121-field-v1

# --- image input ------------------------------------------------------------
# Must match training (the notebook resizes to 256x256).
IMAGE_SIZE=256
# Uploads above this size are rejected with 413.
MAX_UPLOAD_BYTES=10485760

# --- sensors ----------------------------------------------------------------
# How many recent readings the development-only in-memory buffer keeps.
SENSOR_HISTORY_LIMIT=200

# --- rule-based decision layer ----------------------------------------------
# Only used by POST /api/diagnose, never by /api/predict.
# Weight of the photo probabilities when symptom answers are supplied.
DIAGNOSIS_IMAGE_WEIGHT=0.6
# Weight of the symptom checklist when answers are supplied.
DIAGNOSIS_SYMPTOM_WEIGHT=0.4
# Below this photo confidence the answer is reported as "uncertain" instead of
# naming a disease. Measured: 0.75 keeps 75.8% of photos answerable at 94.03%
# accuracy (see training/results/decision_layer.json).
DIAGNOSIS_MIN_CONFIDENCE=0.75
# Top-1 and top-2 closer than this are not separated.
DIAGNOSIS_MIN_MARGIN=0.15

# --- server -----------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list. Only the declared origins are allowed to call the API.
# The mobile app does not need CORS (native apps are not browsers); these are
# for a web preview or a browser-based admin page.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
